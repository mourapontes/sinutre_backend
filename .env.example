# Banco de dados PostgreSQL (Supabase, Neon, Railway...)
# Ex.: postgresql://usuario:senha@host:5432/banco?schema=public
DATABASE_URL="postgresql://usuario:senha@localhost:5432/sinutre?schema=public"

# Servidor
PORT=3333

# Fuso horário usado no cálculo das métricas (média calórica dos últimos 7 dias)
TZ="America/Sao_Paulo"

# GitHub OAuth (crie um OAuth App em https://github.com/settings/developers)
# Em produção, GITHUB_CALLBACK_URL deve apontar para o backend publicado.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3333/auth/github/callback"

# JWT
JWT_SECRET="troque-esta-string-em-producao"

# Frontend (CORS + redirect após login)
# Aceita vários domínios separados por vírgula (produção + preview da Vercel).
FRONTEND_URL="http://localhost:5173"

# Banco de dados PostgreSQL
#
# --- Supabase ---
# Project Settings > Database > Connection string
# DATABASE_URL: use a "Transaction pooler" (porta 6543) + pgbouncer
# DIRECT_URL:   use a "Session pooler" (porta 5432) ou a "Direct connection"
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# --- Railway / Neon / local ---
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?schema=public"
# DIRECT_URL é opcional: se ausente, as migrações usam DATABASE_URL.

# Servidor
PORT=3333

# Fuso horário usado no cálculo das métricas (média calórica dos últimos 7 dias)
TZ="America/Sao_Paulo"

# GitHub OAuth (crie um OAuth App em https://github.com/settings/developers)
# Em produção, GITHUB_CALLBACK_URL deve apontar para o backend publicado.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3333/auth/github/callback"

# JWT
JWT_SECRET="troque-esta-string-em-producao"

# Frontend (CORS + redirect após login)
# Aceita vários domínios separados por vírgula (produção + preview da Vercel).
FRONTEND_URL="http://localhost:5173"
